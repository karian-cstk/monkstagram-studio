# Enables live Jira refresh on /leaderboard. Without these, the page falls
# back to the static snapshot in content/leaderboard.ts.
#
# 1. Generate a token at https://id.atlassian.com/manage-profile/security/api-tokens
# 2. Copy this file to .env.local and fill in the values below.
# 3. Restart the dev server.

JIRA_BASE_URL=https://contentstack.atlassian.net
JIRA_EMAIL=you@contentstack.com
JIRA_API_TOKEN=
